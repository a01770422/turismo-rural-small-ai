# Copia este archivo a .env y rellénalo. NUNCA subas .env a GitHub.
DATABASE_PATH=./data/local_app.db
# Chat con visitantes: 0.0.0.0 = otros teléfonos en la misma wifi pueden abrir http://IP-de-este-equipo:8000/chat
# (solo ven el chat; tu panel sigue siendo solo de este equipo). 127.0.0.1 = solo este equipo.
HOST=0.0.0.0
PORT=8000
# Token del bot de Telegram (créalo con @BotFather -> /newbot). Vacío = modo manual/demo.
TELEGRAM_BOT_TOKEN=
# Si lo defines, se habilita POST /api/inbox (webhook) protegido con header X-Token.
API_TOKEN=
# Cada cuántos segundos revisar mensajes nuevos y enviar la cola. 0 = apagado.
AUTO_SYNC_SECONDS=30

# Zona inicial (OpenStreetMap). Si luego eliges otra desde la web ("Cambiar zona"), esa tiene prioridad.
AREA_NAME=Toluca
AREA_LAT=19.2826
AREA_LON=-99.6557
AREA_RADIUS_M=15000
# 1 = mostrar también los 4 lugares de ejemplo (inventados, para demos). 0 = solo lugares reales de OpenStreetMap
SHOW_SAMPLE=0

# Días que se conservan los mensajes ya enviados (privacidad). 0 = no borrar nunca.
RETENTION_DAYS=30
